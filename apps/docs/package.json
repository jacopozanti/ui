{
  "name": "@ui-sites/docs",
  "private": true,
  "type": "module",
  "description": "Documentation site for @jacopozanti/ui, generated from the library's own source.",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "preview": "vite preview --port 3002",
    "typecheck": "tsc --noEmit",
    "generate-routes": "tsr generate",
    "generate": "node scripts/generate.mjs",
    "predev": "npm run generate",
    "prebuild": "npm run generate",
    "pretypecheck": "npm run generate && npm run generate-routes"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.50",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
